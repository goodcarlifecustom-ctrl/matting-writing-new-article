{
  "name": "writing-matting-article-workflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "create": "node scripts/create-article-dir.mjs",
    "extract": "node scripts/extract-headings.mjs",
    "check": "node scripts/check-article.mjs --mode draft",
    "check:draft": "node scripts/check-article.mjs --mode draft",
    "check:publish": "node scripts/check-article.mjs --mode publish",
    "check:evidence": "node scripts/check-review-evidence.mjs",
    "check:evidence:all": "node scripts/check-review-evidence.mjs --all --stage verify",
    "check:content": "node scripts/check-all-content.mjs",
    "check:sources": "node scripts/check-all-sources.mjs",
    "check:repository": "npm run check:content && npm run check:sources && npm run check:evidence:all",
    "ci": "npm test && npm run check:repository",
    "test": "node --test --test-concurrency=1",
    "decorate": "node scripts/decorate-article.mjs",
    "check:decoration": "node scripts/check-decoration.mjs",
    "finish": "node scripts/finish-new-article.mjs"
  },
  "dependencies": {
    "parse5": "^7.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@wordpress/block-serialization-default-parser": "^5.48.1"
  }
}
